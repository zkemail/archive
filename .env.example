# Copy to .env and fill in.
#
# Only the variables below are read anywhere in the codebase. If you set
# something not listed here, nothing will consume it.

# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Read by src/lib/db.ts and prisma.config.ts.
# If unset, prisma.config.ts silently falls back to
# postgresql://localhost/archive, which is a confusing way to find out.
DATABASE_URL=

# ─── Gmail integration (NextAuth v5) ─────────────────────────────────────────
# Needed for the Gmail upload flow. The app runs without them; signing in does
# not. Note the AUTH_ prefix: v5 renamed these from the older NEXTAUTH_/GOOGLE_
# names, and the old ones are not read.

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Session encryption. NextAuth reads this from the environment itself, so it
# does not appear as an explicit process.env reference in the source.
AUTH_SECRET=

# ─── Scheduled jobs ──────────────────────────────────────────────────────────

# Shared secret guarding POST /api/batch_update and POST /api/stats. Leave
# unset only in local development.
CRON_SECRET=

# ─── GCD key recovery (GCP Cloud Tasks + Cloud Function) ─────────────────────
# Only needed to run the public-key recovery pipeline. Everything else works
# without them.

GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_REGION=
CLOUD_TASKS_QUEUE_NAME=
CLOUD_FUNCTION_URL=
TASKS_SERVICE_ACCOUNT_EMAIL=
# Service account JSON, inline. Falls back to application default credentials
# when unset.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Development only: the callback base URL the Cloud Function posts results to.
# In production this is derived from the request host.
CALLBACK_URL=

# ─── Signed observation statements (optional) ────────────────────────────────

# Private JWK (JSON, one line) used to sign offline-verifiable observation
# statements. Must include "kid" and "alg" (EdDSA or ES256), and its public half
# must already be committed to src/lib/archive-statement-jwks.json; the signer
# refuses to sign under an unpublished kid. Mint one with `pnpm statement:genkey`.
# Unset means /api/key/statement returns 503 for any pair that has an
# observation to attest (a pair with none still returns 200 and an empty array,
# because it never reaches the signer). Nothing else is affected.
#
# Production only. Set it nowhere else: the published key set is a committed
# file, so any deployment holding this can mint statements consumers accept as
# ours. Preview deployments refuse to sign even if they somehow receive it.
ARCHIVE_STATEMENT_SIGNING_JWK=

# ─── Analytics (optional) ────────────────────────────────────────────────────

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
